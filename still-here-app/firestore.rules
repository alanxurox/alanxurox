rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isPaidUser() {
      return isAuthenticated() &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isPaid == true;
    }

    // Users collection
    match /users/{userId} {
      // Anyone can read their own user document
      allow read: if isOwner(userId);

      // Users can create their own document (on signup)
      allow create: if isAuthenticated() && request.auth.uid == userId;

      // Users can update their own document (settings, check-ins)
      allow update: if isOwner(userId);

      // Users can delete their own document
      allow delete: if isOwner(userId);
    }

    // Emergency contacts collection
    match /contacts/{contactId} {
      // Read: Only the owner can read their contacts
      allow read: if isAuthenticated() &&
                     resource.data.userId == request.auth.uid;

      // Create: Only if user is authenticated and owns the contact
      allow create: if isAuthenticated() &&
                       request.resource.data.userId == request.auth.uid &&
                       isPaidUser();

      // Update: Only the owner can update their contacts
      allow update: if isAuthenticated() &&
                       resource.data.userId == request.auth.uid;

      // Delete: Only the owner can delete their contacts
      allow delete: if isAuthenticated() &&
                       resource.data.userId == request.auth.uid;
    }

    // Check-ins collection
    match /checkins/{checkInId} {
      // Read: Users can read their own check-ins
      allow read: if isAuthenticated() &&
                     resource.data.userId == request.auth.uid;

      // Create: Users can create their own check-ins (if paid)
      allow create: if isAuthenticated() &&
                       request.resource.data.userId == request.auth.uid &&
                       isPaidUser();

      // Update/Delete: Check-ins are immutable (no updates/deletes)
      allow update, delete: if false;
    }

    // Alerts collection (read-only for users, written by Cloud Functions)
    match /alerts/{alertId} {
      // Read: Users can read their own alerts
      allow read: if isAuthenticated() &&
                     resource.data.userId == request.auth.uid;

      // Write: Only Cloud Functions can write (no direct user access)
      allow write: if false;
    }

    // Payments collection (optional, for tracking purchases)
    match /payments/{paymentId} {
      // Read: Users can read their own payment records
      allow read: if isAuthenticated() &&
                     resource.data.userId == request.auth.uid;

      // Create: Cloud Functions or user (via RevenueCat)
      allow create: if isAuthenticated() &&
                       request.resource.data.userId == request.auth.uid;

      // Update/Delete: No updates or deletes allowed
      allow update, delete: if false;
    }

    // Analytics collection (optional, for app metrics)
    match /analytics/{docId} {
      // No direct access - only Cloud Functions
      allow read, write: if false;
    }

    // Default: Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
